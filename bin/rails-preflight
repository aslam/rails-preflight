#!/usr/bin/env ruby
# frozen_string_literal: true

# No bundler/setup on purpose: it would load the Gemfile in the current directory,
# which is usually the app being audited, often pinned to an old Ruby.
lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

require 'rails_preflight'

if %w[-h --help].include?(ARGV[0])
  puts "Usage: rails-preflight [--offline] [--format html|markdown|json] [--fail-on blockers|broken] [TARGET_RAILS_VERSION] [APP_PATH]"
  puts "Example: rails-preflight 7.2 ~/code/my_app"
  puts "TARGET defaults to the next Rails minor after the app's; APP_PATH to the current directory."
  puts "--offline: don't call rubygems.org; gems the lockfile can't place are reported as unchecked, and gem release dates are skipped."
  puts "--format markdown|json: print the report on stdout (progress goes to stderr) instead of writing the HTML file."
  puts "--fail-on blockers: exit 1 when anything blocks the upgrade or is already broken. --fail-on broken: only when something is already broken."
  exit
end

offline = !ARGV.delete("--offline").nil?
format = :html
if (i = ARGV.index("--format"))
  format = ARGV.slice!(i, 2)[1].to_s.to_sym
  abort "--format must be html, markdown or json (got #{format})." unless %i[html markdown json].include?(format)
end
fail_on = nil
if (i = ARGV.index("--fail-on"))
  fail_on = ARGV.slice!(i, 2)[1].to_s.to_sym
  abort "--fail-on must be blockers or broken (got #{fail_on})." unless %i[blockers broken].include?(fail_on)
end

# The target is optional, so a lone argument that isn't a version is the app path.
target = ARGV.shift if ARGV[0] && (Gem::Version.correct?(ARGV[0]) || !File.directory?(ARGV[0]))
abort "Target must be a Rails version such as 7.2 (got #{target.inspect})." if target && !Gem::Version.correct?(target)
project_path = ARGV[0] || Dir.pwd

begin
  summary = RailsPreflight::UpgradeAnalyzer.new(target, project_path, offline: offline, format: format).run
rescue RailsPreflight::Error => e
  abort e.message
end

# Already broken is worse than blocked, so --fail-on blockers counts it too.
failing = { blockers: %i[broken blockers], broken: %i[broken] }.fetch(fail_on, []).sum { |key| summary&.fetch(key)&.size.to_i }
exit 1 if failing.positive?
