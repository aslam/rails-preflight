#!/usr/bin/env ruby
# frozen_string_literal: true

# Shim for Bundler/Ruby 3.4 compatibility (taint/untaint removed)
# Must be defined BEFORE bundler/setup because old Bundler versions use it.
class Object; def taint; self; end; def untaint; self; end; end
class String; def taint; self; end; def untaint; self; end; end

require 'bundler/setup'

# Add lib to load path to test without installing
lib = File.expand_path("../lib", __dir__)
$LOAD_PATH.unshift(lib) unless $LOAD_PATH.include?(lib)

require 'rails_preflight'

if ARGV.empty?
  puts "Usage: rails-preflight [TARGET_RAILS_VERSION]"
  puts "Example: rails-preflight 5.2"
  exit 1
end

target = ARGV[0]
project_path = ARGV[1] || Dir.pwd

RailsPreflight::UpgradeAnalyzer.new(target, project_path).run
